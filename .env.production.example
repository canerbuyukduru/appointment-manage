# ==============================================
# RANDEVU YÖNETİM SİSTEMİ — Production Ortam
# cp .env.production.example .env
# ==============================================

# ---- Veritabanı ----
DB_USER=randevu
DB_PASSWORD=GUCLU_SIFRE_BURAYA_GIR
DB_NAME=randevu_db
# Docker içi bağlantı (container adı: postgres)
DATABASE_URL=postgresql://randevu:GUCLU_SIFRE_BURAYA_GIR@postgres:5432/randevu_db

# ---- Redis ----
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ---- JWT (min 32 karakter, rastgele üret) ----
JWT_SECRET=BURAYI_DEGISTIR_EN_AZ_32_KARAKTER_OLSIN_1
JWT_REFRESH_SECRET=BURAYI_DEGISTIR_EN_AZ_32_KARAKTER_OLSIN_2
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Uygulama ----
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://DOMAIN_ADINIZ.COM

# ---- Domain (nginx için) ----
DOMAIN_NAME=DOMAIN_ADINIZ.COM

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://DOMAIN_ADINIZ.COM/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Stripe (Production) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---- iyzico (TR Ödeme - Opsiyonel) ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# ---- Cloudinary ----
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SendGrid ----
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@DOMAIN_ADINIZ.COM
SENDGRID_FROM_NAME=Randevu Sistemi

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+90...

# ---- Firebase (Push) ----
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ---- Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Admin ----
ADMIN_EMAIL=admin@DOMAIN_ADINIZ.COM
ADMIN_PASSWORD=ADMIN_SIFRESINI_DEGISTIR

# ---- Komisyon ----
PLATFORM_COMMISSION_RATE=0.10

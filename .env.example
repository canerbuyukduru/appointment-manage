# ==============================================
# RANDEVU YÖNETİM SİSTEMİ — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve doldur:
#   cp .env.example .env
# ==============================================

# ---- Veritabanı ----
DB_USER=randevu
DB_PASSWORD=randevu_pass
DB_NAME=randevu_db
DATABASE_URL=postgresql://randevu:randevu_pass@localhost:5432/randevu_db
DATABASE_URL_TEST=postgresql://randevu:randevu_pass@localhost:5432/randevu_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_SECRET=change_me_super_secret_key_min_32_chars
JWT_REFRESH_SECRET=change_me_another_secret_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Uygulama ----
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Stripe (Ödeme) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- iyzico (TR Ödeme - Opsiyonel) ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ---- Cloudinary (Dosya Depolama) ----
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SendGrid (Email) ----
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@randevusistemi.com
SENDGRID_FROM_NAME=Randevu Sistemi

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+90...

# ---- Firebase (Push Bildirim) ----
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ---- Google (OAuth + Maps) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Admin ----
ADMIN_EMAIL=admin@randevusistemi.com
ADMIN_PASSWORD=change_me_admin_password

# ---- Komisyon ----
PLATFORM_COMMISSION_RATE=0.10
